# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection. The database must use UTF8 encoding.
DATABASE_URL="postgresql://linkmarket:CHANGE_ME@localhost:5432/linkmarket?schema=public"

# First Admin account, created by `npm run db:seed`. Use a strong password (8+ characters).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME"

# Port the app listens on (Nginx/Caddy forwards to it).
PORT=3000
# Production: listen only on this machine so the port isn't reachable from the internet.
# Leave unset in development.
# HOST="127.0.0.1"

# Uploaded images and chat files are stored on disk in ./uploads by default.
# To use S3-compatible storage instead, uncomment and fill in:
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# Development only: also create sample Clients, Customers and posts when seeding.
# The seed skips them automatically when NODE_ENV=production.
# SEED_SAMPLE_DATA="true"
